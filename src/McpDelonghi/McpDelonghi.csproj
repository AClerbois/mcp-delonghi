<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-delonghi</ToolCommandName>
    <PackageId>AClerbois.MCP.DelonghiConnector</PackageId>
    <Version>1.0.0</Version>
    <Authors>adrie</Authors>
    <Description>MCP server to control De'Longhi coffee machines (Eletta Explore, Dinamica Plus, PrimaDonna) via the De'Longhi Coffee Link cloud (Gigya + Ayla Networks).</Description>
    <PackageTags>mcp;delonghi;coffee;iot;ayla;ai</PackageTags>
    <PackageProjectUrl>https://github.com/aclerbois/mcp-delonghi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aclerbois/mcp-delonghi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

</Project>
